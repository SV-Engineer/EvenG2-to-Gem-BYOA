# ==========================================
# Server Configuration
# ==========================================
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ==========================================
# Client-to-Bridge Security
# ==========================================
# Shared secret token required in: Authorization: Bearer <PROXY_API_KEY>
# Enter this exact key in the Even App's "Agent Configuration" menu.
PROXY_API_KEY=your_secure_custom_proxy_token_here

# ==========================================
# Google Gemini Configuration
# ==========================================
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Set to true to test the bridge without calling the Gemini API (saves quota)
MOCK_GEMINI=false

# ==========================================
# HUD Prompt Tuning (For G2 MicroLED Screen)
# ==========================================
HUD_MAX_CHARACTERS=300
HUD_SYSTEM_PROMPT="You are an AI assistant displayed on Even Realities G2 smart glasses. Keep your responses extremely concise (1 to 3 short sentences maximum). Respond in plain text only. Never use markdown formatting, bullet points, asterisks, headers, or bold text."
